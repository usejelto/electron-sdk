{
  "name": "@jelto/electron",
  "version": "1.1.3",
  "description": "Jelto SDK for Electron \u2014 main process only. spec/wire-v1.md v1, spec/sdk-conformance.md.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/usejelto/electron-sdk.git"
  },
  "bugs": {
    "url": "https://github.com/usejelto/electron-sdk/issues"
  },
  "homepage": "https://jelto.io/docs/sdk/electron-forge",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.cjs",
      "import": "./dist/index.mjs"
    }
  },
  "files": [
    "dist/index.cjs",
    "dist/index.mjs",
    "dist/*.d.ts",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node build.mjs",
    "check": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.host.json",
    "test": "npm run test:sdk && npm run test:host",
    "test:sdk": "node --test \"src/**/*.test.ts\"",
    "test:host": "node --test \"host/**/*.test.ts\""
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "dependency-cruiser": "^18.7.2",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "knip": "^6.45.1",
    "prettier": "^3.10.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.2"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "overrides": {
    "minimatch": "11.0.1"
  }
}
